[gd_resource type="Resource" script_class="EmberCombatLootTableResource" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/prototypes/ember_combat_loot_table_resource.gd" id="1_table"]
[ext_resource type="Script" path="res://scripts/prototypes/ember_combat_loot_entry_resource.gd" id="2_entry"]

[sub_resource type="Resource" id="LootEntry_tea"]
script = ExtResource("2_entry")
