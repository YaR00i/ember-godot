[resource]
script = ExtResource("1_pl5on")
dialogue_id = "shore_shells_thanks"
document = {
"id": "shore_shells_thanks",
"nameRu": "Хранитель берега",
"startStepId": "line",
"steps": [{
"id": "line",
"next": "end",
"textRu": "Все три ракушки на месте, спасибо. Теперь добудь кожу кабана: он бродит на поляне дальше за домом, налево от меня. Подойди и ударь левой кнопкой мыши. Удар со спины даст большее преимущество. После победы возвращайся за наградой.",
"type": "dialogue"
}, {
"id": "end",
"type": "end"
}]
}
