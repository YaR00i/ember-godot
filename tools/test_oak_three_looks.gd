extends SceneTree
const Bake=preload("res://scripts/ember_tree_look_bake.gd")
var errors: Array[String]=[]
func check(ok: bool,label: String) -> void:
	if not ok:errors.append(label);printerr("FAIL ",label)
func _initialize() -> void:run.call_deferred()
func run() -> void:
	var source: EmberVoxelModelResource=load("res://content/voxel_models/vox_painted_oak.tres")
	var model: Dictionary=source.to_definition().model;var before:=hash(model)
	var smooth:=Bake.Surface.build(model);var a:=Bake.build_faceted(model);var b:=Bake.build_faceted(model)
	check(a.puffs.size()==399 and a.cards==885,"same accepted leaf sites")
	check(a.triangles<smooth.get_faces().size()/3,"faceted geometry actually reduced")
	for i in a.mesh.get_surface_count():check(a.mesh.surface_get_arrays(i)==b.mesh.surface_get_arrays(i),"deterministic faceted buffers")
	check(hash(model)==before,"Source not modified")
	var leaf: ShaderMaterial=a.mesh.surface_get_material(1)
	check(leaf.get_shader_parameter("painted_leaf_card_albedo")==smooth.surface_get_material(1).get_shader_parameter("painted_leaf_card_albedo"),"same leaf artwork")
	check(is_equal_approx(leaf.get_shader_parameter("painted_leaf_shadow_strength"),0.4),"shadow receive retained")
	var shape: Texture2D=leaf.get_shader_parameter("faceted_leaf_shape")
	check(shape!=null and shape.get_image().has_mipmaps(),"derived shape has distance filtering")
	check(float(leaf.get_shader_parameter("faceted_leaf_shape_amount"))==0.0,"base bake preserves original alpha")
	var original_image:=Image.load_from_file(Bake.Species.LEAF_ART[int(model.treeSurface.settings.tree_type)])
	var original_pixels:=original_image.get_data()
	var mask:=Bake.LeafShape.build(original_image)
	check(mask.components==96 and mask.treated>80,"separate leaves found; not whole atlas clusters")
	check(original_image.get_data()==original_pixels,"original artwork untouched")
	check(shape.get_image().get_data()==mask.image.get_data(),"shape recipe deterministic")
	check(float(a.mesh.surface_get_material(0).get_shader_parameter("painted_bark_pixel_m"))==0.0,"faceted bark not pixelated")
	var zero:=model.duplicate(true);zero.treeSurface.settings.tree_leaf_density=0
	check(Bake.build_faceted(zero).mesh.get_surface_count()==1,"zero density")
	var local:=model.duplicate(true);var groups:=Bake.Geometry.crown_leaf_groups(Bake.Surface.leaf_layout(model))
	local.treeSurface.settings.tree_leaf_local={str(groups.keys()[0]):0.0}
	var reduced:=Bake.build_faceted(local)
	check(reduced.puffs.size()<a.puffs.size(),"local thinning")
	for key in reduced.puffs:check(key in a.puffs,"local identities retained")
	var paint:=model.duplicate(true);paint.palette[1]="cc4433"
	check(Bake.build_faceted(paint).mesh.surface_get_arrays(0)[Mesh.ARRAY_COLOR]!=a.mesh.surface_get_arrays(0)[Mesh.ARRAY_COLOR],"source paint reaches facets")
	check(ResourceSaver.save(a.mesh,"user://oak-faceted-test.res")==OK,"save derived")
	var loaded: ArrayMesh=ResourceLoader.load("user://oak-faceted-test.res","",ResourceLoader.CACHE_MODE_IGNORE_DEEP)
	for i in a.mesh.get_surface_count():check(a.mesh.surface_get_arrays(i)==loaded.surface_get_arrays(i),"derived roundtrip")
	check(loaded.surface_get_material(1).get_shader_parameter("faceted_leaf_shape").get_image().get_data()==shape.get_image().get_data(),"derived shape roundtrip")
	var voxel:=Bake.build(model)
	check(voxel.cells==58421 and voxel.triangles==338328,"accepted voxel shape retained")
	var arrays: Array=voxel.mesh.surface_get_arrays(1)
	check(arrays[Mesh.ARRAY_CUSTOM2].size()==arrays[Mesh.ARRAY_VERTEX].size()*4,"source form normals reach all voxel leaf vertices")
	print("OAK_THREE_TEST ","PASS" if errors.is_empty() else errors," smooth=",smooth.get_faces().size()/3," faceted=",a.triangles)
	quit(0 if errors.is_empty() else 1)
