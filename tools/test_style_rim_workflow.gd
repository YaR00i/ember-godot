extends SceneTree
const Materials=preload("res://scripts/ember_voxel_surface_materials.gd")
const Profiles=preload("res://scripts/ember_voxel_material_profiles.gd")
const Dialog=preload("res://addons/ember_import/ember_compact_material_pattern_dialog.gd")
const Look=preload("res://addons/ember_import/ember_world_look_panel.gd")
const Workspace=preload("res://addons/ember_import/ember_voxel_sculpt_workspace.gd")
const Actions=preload("res://addons/ember_import/ember_voxel_sculpt_actions.gd")
const SurfaceProjection=preload("res://scripts/ember_voxel_surface_projection.gd")
const TerrainProjection=preload("res://scripts/prototypes/ember_terrain_pilot_projection.gd")
func _initialize() -> void: run.call_deferred()
func run() -> void:
	DirAccess.make_dir_recursive_absolute("user://ember-tests")
	var legacy=Materials.load_compact_terrain_variant("painted_light_grass")
	assert(not legacy.style_rim_custom)
	var pattern=legacy.duplicate(true);pattern.style_rim_custom=true;pattern.style_rim_enabled=true;pattern.style_rim_strength=0.18
	var bad=pattern.duplicate(true);bad.style_rim_strength=NAN;assert(not bad.validation_errors().is_empty())
	var other=pattern.duplicate(true);other.style_rim_strength=0.45
	var material=Materials.compact_terrain_material()
	Materials.set_compact_terrain_roles(material,PackedStringArray(["","grass","grass"]),PackedStringArray(["","first","second"]),PackedColorArray(),{"first":legacy,"second":other})
	var lookup: Image=material.get_meta("ember_style_rim_image")
	assert(lookup.get_pixel(1,0).r==0 and is_equal_approx(lookup.get_pixel(2,0).b,0.45))
	var identity: int=material.get_shader_parameter("style_rim_lookup").get_instance_id()
	Materials.update_style_rim_profile(material,1,pattern)
	assert(material.get_shader_parameter("style_rim_lookup").get_instance_id()==identity)
	assert(is_equal_approx(lookup.get_pixel(1,0).b,0.18) and is_equal_approx(lookup.get_pixel(2,0).b,0.45))
	var path:="user://ember-tests/style-rim-pattern.tres"
	assert(ResourceSaver.save(legacy.duplicate(true),path)==OK)
	var projection=TerrainProjection.new();projection.document=load("res://content/world_terrains/material_depth_study.res").working_copy()
	projection.document.palette_surface_roles=PackedStringArray(["","grass","grass"])
	projection.document.palette_material_ids=PackedStringArray(["","first","second"]);projection._ground_material=material
	var panel=Dialog.new();root.add_child(panel);root.add_child(panel.parameters_panel)
	panel.light_profile_previewed.connect(projection.preview_shared_material_light)
	panel.pattern_path_override=path;assert(panel.open_variant("first","grass"))
	var pixels: PackedByteArray=panel._draft.pixels.duplicate();var texture: Texture2D=panel._draft.albedo_texture
	panel._style_rim_switch.button_pressed=true;panel._style_rim_slider.value=0.18
	assert(panel._draft.style_rim_custom and is_equal_approx(lookup.get_pixel(1,0).b,0.18))
	panel.undo_edit();assert(is_equal_approx(panel._draft.style_rim_strength,0.7) and panel._draft.style_rim_enabled);panel.redo_edit()
	assert(panel._save(true));var saved=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE)
	assert(saved.style_rim_enabled and is_equal_approx(saved.style_rim_strength,0.18))
	var file_hash:=FileAccess.get_sha256(path)
	panel._style_rim_switch.button_pressed=false;assert(panel.is_dirty());panel.cancel_edit()
	assert(FileAccess.get_sha256(path)==file_hash and lookup.get_pixel(1,0).g==1)
	assert(is_equal_approx(lookup.get_pixel(2,0).b,0.45))
	assert(saved.pixels==pixels)
	assert(saved.albedo_texture.get_image().get_data()==texture.get_image().get_data())
	panel.free();projection.free()
	var source: EmberVoxelModelResource=load("res://content/voxel_models/vox_tree_522448705.tres").duplicate(true)
	Profiles.assign(source.material,"bark",{"2":"foliage"})
	assert(not Profiles.rim_parameters(source.material,"bark").enabled and is_equal_approx(Profiles.rim_parameters(source.material,"bark").strength,0.45))
	assert(is_equal_approx(Profiles.rim_parameters(source.material,"foliage").strength,0.18))
	var source_before:=source.voxels.duplicate();var palette_before:=source.palette.duplicate();var initial_material:=source.material.duplicate(true)
	var invalid:=Profiles.with_rim(source.material,"bark",true,NAN);assert(not Profiles.validation_errors(invalid,source.palette.size()).is_empty())
	var undo:=UndoRedo.new();var actions:=Actions.new();actions.configure(undo)
	assert(actions.apply_style_rim(source,"bark",true,0.45));assert(actions.apply_style_rim(source,"foliage",true,0.18))
	assert(Profiles.base_material(source.material).object_surface.style_rim==source.material.object_surface.style_rim)
	undo.undo();assert(not Profiles.rim_parameters(source.material,"foliage").enabled);undo.redo()
	var shader_material:=EmberVoxelPrefab.voxel_material().duplicate() as ShaderMaterial
	Profiles.apply_rim(shader_material,source.material)
	var profiles: PackedVector2Array=shader_material.get_shader_parameter("object_style_rim_profiles")
	assert(profiles[2].is_equal_approx(Vector2(1,0.45)) and profiles[3].is_equal_approx(Vector2(1,0.18)))
	assert(source.voxels==source_before and source.palette==palette_before)
	# Real Surface Canvas signals, one release action, no geometry rebuild.
	var workspace:=Workspace.new();workspace.setup(null,undo);root.add_child(workspace)
	var grid:=source.grid_size();var first_voxel:=source.voxels.find(1)
	assert(first_voxel>=0)
	var block:=Vector2i((first_voxel%grid.x)/source.normalized_density(),(first_voxel/(grid.x*grid.y))/source.normalized_density())
	workspace.open_surface(source,"user://ember-tests/style-rim-tree.tres",Rect2i(block,Vector2i.ONE))
	for frame in 4:await process_frame
	var chunks:={}
	for key in workspace._chunk_meshes:chunks[key]=workspace._chunk_meshes[key].mesh
	workspace._palette_panel.sync(source,1)
	var count:=undo.get_history_count()
	workspace._palette_panel._rim_slider.drag_started.emit()
	workspace._palette_panel._rim_slider.value=0.35;workspace._palette_panel._rim_slider.value=0.25
	assert(undo.get_history_count()==count)
	workspace._palette_panel._rim_slider.drag_ended.emit(true)
	assert(undo.get_history_count()==count+1 and is_equal_approx(Profiles.rim_parameters(source.material,"bark").strength,0.25))
	for key in chunks:assert(chunks[key]==workspace._chunk_meshes[key].mesh)
	var world_preview=SurfaceProjection.new();world_preview._surface=source
	var visual:=MeshInstance3D.new()
	# Reuse a current Canvas mesh: this assertion targets the lightweight binder.
	for chunk: MeshInstance3D in workspace._chunk_meshes.values():
		if chunk.mesh!=null and chunk.mesh.get_surface_count()>0:visual.mesh=chunk.mesh;break
	assert(visual.mesh!=null)
	world_preview._chunks={Vector2i.ZERO:visual};world_preview.refresh_style_rim_materials()
	assert(world_preview._style_rim_material.get_shader_parameter("object_style_rim_profiles_enabled"))
	var visual_id:=visual.mesh.get_instance_id()
	world_preview.refresh_style_rim_materials();assert(visual.mesh.get_instance_id()==visual_id)
	world_preview._chunks.clear();visual.free();world_preview.free()
	undo.undo();assert(is_equal_approx(Profiles.rim_parameters(source.material,"bark").strength,0.45));undo.redo()
	assert(workspace.has_unsaved_changes());assert(workspace._save())
	saved=ResourceLoader.load("user://ember-tests/style-rim-tree.tres","",ResourceLoader.CACHE_MODE_IGNORE)
	assert(is_equal_approx(Profiles.rim_parameters(saved.material,"bark").strength,0.25))
	workspace._palette_panel._rim_switch.button_pressed=false;workspace.discard_changes()
	assert(Profiles.rim_parameters(source.material,"bark").enabled and not workspace.has_unsaved_changes())
	workspace.free();undo.free()
	# Map master is scene data; does not modify material assets or local values.
	var scene:=Node3D.new();scene.name="RimScene";root.add_child(scene)
	var map:=EmberMapLoader.new();map.name="Map";scene.add_child(map);map.owner=scene
	var look=Look.new();root.add_child(look);undo=UndoRedo.new();look.set_target(scene,map,undo)
	look._rim_switch.button_pressed=false;assert(not map.compact_style_rim_enabled)
	undo.undo();assert(map.compact_style_rim_enabled);undo.redo()
	var packed:=PackedScene.new();assert(packed.pack(scene)==OK)
	assert(ResourceSaver.save(packed,"user://ember-tests/style-rim-scene.tscn")==OK)
	var reopened=ResourceLoader.load("user://ember-tests/style-rim-scene.tscn","",ResourceLoader.CACHE_MODE_IGNORE).instantiate()
	assert(not reopened.get_node("Map").compact_style_rim_enabled)
	reopened.free();look.free();undo.free();scene.free()
	print("STYLE_RIM_WORKFLOW PASS validation/legacy/independent profiles/live lookup/paint/one release/no remesh/Undo-Redo/Save-Reopen/Discard/map master")
	quit()
