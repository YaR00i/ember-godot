extends SceneTree
const Fixture=preload("res://scripts/prototypes/ember_terrain_shape_fixture.gd")
const Terrain=preload("res://scripts/prototypes/ember_terrain_pilot_resource.gd")
const Rules=preload("res://scripts/prototypes/ember_terrain_surface_rules.gd")
const Smooth=preload("res://scripts/prototypes/ember_terrain_smooth_surface.gd")
const Mesher=preload("res://scripts/prototypes/ember_terrain_pilot_mesh.gd")
const Brush=preload("res://addons/ember_import/ember_compact_terrain_brush.gd")
const Map=preload("res://scripts/ember_map_loader.gd")
const Sessions=preload("res://addons/ember_import/ember_world_edit_sessions.gd")
const Cache=preload("res://scripts/prototypes/ember_terrain_geometry_cache.gd")
const Extension=preload("res://addons/ember_import/ember_compact_map_extension.gd")
var errors: Array[String]=[]
func _initialize() -> void:run.call_deferred()
func check(ok: bool,message: String) -> void:
	if not ok:errors.append(message);printerr("FAIL ",message)
func settle(projection) -> void:
	var deadline:=Time.get_ticks_msec()+60000
	while projection.pending_tile_count()>0 and Time.get_ticks_msec()<deadline:await process_frame
	await physics_frame;await physics_frame
	check(projection.pending_tile_count()==0,"projection settles")
func run() -> void:
	var source:=Fixture.source();var original:=source.working_copy()
	var bounds:=Rect2i(0,0,64,64)
	var before:=Smooth.field(source,bounds)
	var plain:=Mesher.build_tile(source,0,0,64,0,false,PackedVector4Array(),{},false,false,false)
	var cache:=Cache.new();var key0:=cache.tile_key(source,Vector2i.ZERO,0,[1],PackedVector4Array(),{})
	var cells: Dictionary={}
	for rect: Rect2 in Fixture.PROTECTED_REGIONS:
		var area:=Rect2i(Vector2i(rect.position*16),Vector2i(rect.size*16))
		for z in range(area.position.y,area.end.y):
			for x in range(area.position.x,area.end.x):cells[Vector2i(x,z)]=255
	source.surface_rules=Rules.changed({},cells)
	check(source.validation_errors().is_empty(),"source rules validate")
	var after:=Smooth.field(source,bounds)
	check(Smooth.sample(after,Vector2(32,19))>Smooth.sample(before,Vector2(32,19))+1.0,"explicit preservation retains plateau lip")
	check(source.heights==original.heights and source.top_materials==original.top_materials,"rules preserve common sculpt and paint")
	check(Mesher.build_tile(source,0,0,64,0,false,PackedVector4Array(),{},false,false,false).collision_faces==plain.collision_faces,"voxel geometry unchanged")
	check(cache.tile_key(source,Vector2i.ZERO,1,[1],PackedVector4Array(),{})!=key0,"rules participate in geometry cache")
	var sectioned=source.sectioned_copy()
	check(sectioned.validation_errors().is_empty(),"sectioned root owns rules")
	var dense_mesh:=Mesher.build_tile(source,64,0,64,0,false,PackedVector4Array(),{},false,false,true,true)
	var section_mesh:=Mesher.build_tile(sectioned,64,0,64,0,false,PackedVector4Array(),{},false,false,true,true)
	check(dense_mesh.collision_faces==section_mesh.collision_faces,"dense/sectioned rule geometry exact")
	var shifted=Extension.expanded(sectioned,"west","flat",0)
	check(shifted!=null and Rules.read(shifted.surface_rules,Vector2i(32+384,19))==255,"extension preserves rule address")
	var win=source.dense_window(Rect2i(16,16,64,64))
	check(Rules.read(win.surface_rules,Vector2i(16,3))==255,"window transfers source-local rule")
	var copy:=source.working_copy();copy.surface_rules=Rules.changed(copy.surface_rules,{Vector2i(32,19):0})
	check(Rules.read(source.surface_rules,Vector2i(32,19))==255,"private draft doesn't mutate source rules")
	var malformed:=source.working_copy();malformed.surface_rules={Vector2i.ZERO:PackedByteArray([1])}
	check(not malformed.validation_errors().is_empty(),"bad rule payload rejected")
	malformed=source.working_copy();malformed.surface_rules=Rules.changed({}, {Vector2i(4,4):97})
	check(not malformed.validation_errors().is_empty(),"reserved code rejected")
	var recolored:=source.working_copy();recolored.top_materials.fill(3)
	check(Smooth.field(recolored,bounds).heights==after.heights,"material does not select shape")
	# Radius and strength are local rule values, not global shader settings.
	var round_source:=original.working_copy();round_source.surface_rules=Rules.changed({}, {Vector2i(32,19):Rules.round_code(0.6,2)})
	check(not Smooth.field(round_source,bounds).heights.is_empty(),"radius2 local rule builds")
	var path:="user://ember-tests/rules-source.res";DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	check(ResourceSaver.save(original,path)==OK,"fixture saved")
	var map:=Map.new();map.name="Map";map.hydrate_legacy_regions=false;map.compact_ground_style=1;map.imported_tile_size=1;map.compact_terrain=ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_IGNORE)
	var scene:=Node3D.new();scene.name="RuleScene";root.add_child(scene);scene.add_child(map);map.owner=scene
	var projection=map._visual_surface_projection;await settle(projection)
	var sessions:=Sessions.new();var entry:=sessions.open_map(map,scene);await settle(projection)
	var history:=UndoRedo.new();var brush:=Brush.new();brush.configure(entry,history,scene)
	sessions.configure(history,func():var saved:=PackedScene.new();var error:=saved.pack(scene);return ResourceSaver.save(saved,scene.scene_file_path) if error==OK else error)
	brush.begin("shape_protect",1.0,1,1,0,16,0,1,0,-99999,"detail","circle",0,false,0);brush.stamp(Vector2i(32,19));brush.end()
	check(entry.resource.surface_rules.is_empty(),"zero protection is no-op")
	check(brush.begin("shape_protect",1.0,1,1,0,16,0,1,0,-99999,"coarse","circle",0,false,255),"rule brush begins")
	brush.stamp(Vector2i(32,19));check(entry.resource.surface_rules.is_empty() and projection.pending_tile_count()==0,"motion doesn't publish or remesh")
	brush.end();await settle(projection)
	var painted: Terrain=entry.resource.working_copy()
	check(not painted.surface_rules.is_empty(),"pointer-up commits rules")
	check(painted.heights==original.heights and painted.top_materials==original.top_materials,"brush preserves source heights/paint")
	var ray:=PhysicsRayQueryParameters3D.create(Vector3(2,8,1.1875),Vector3(2,-1,1.1875))
	var floor: Dictionary=map.surface_floor_sample(ray.from);var hit:=root.world_3d.direct_space_state.intersect_ray(ray)
	check(not hit.is_empty() and hit.position.distance_to(floor.position)<0.001,"rule floor/physics parity")
	history.undo();await settle(projection);check(entry.resource.same_terrain_data(original),"one stroke Undo exact")
	history.redo();await settle(projection);check(entry.resource.same_terrain_data(painted),"Redo exact")
	check(brush.begin("shape_clear",1.0,1,1,0,16,0,1,0),"clear begins");brush.stamp(Vector2i(32,19));brush.cancel()
	check(entry.resource.same_terrain_data(painted) and projection.pending_tile_count()==0,"cancel doesn't publish")
	check(brush.begin("shape_clear",1.0,1,1,0,16,0,1,0),"clear begins again");brush.stamp(Vector2i(32,19));brush.end();await settle(projection)
	check(entry.resource.surface_rules.is_empty(),"clear removes local rule")
	history.undo();await settle(projection)
	var packed:=PackedScene.new();check(packed.pack(scene)==OK,"fixture scene packs")
	scene.scene_file_path="user://ember-tests/rules-scene.tscn";check(ResourceSaver.save(packed,scene.scene_file_path)==OK,"fixture scene saved")
	check(sessions.save_all(scene),"existing save workflow: "+sessions.error)
	var reopened=(ResourceLoader.load(scene.scene_file_path,"",ResourceLoader.CACHE_MODE_IGNORE) as PackedScene).instantiate()
	check(reopened.get_node("Map").compact_terrain.same_terrain_data(painted),"Save/Reopen rules exact")
	reopened.free()
	check(brush.begin("shape_clear",1.0,1,1,0,16,0,1,0),"discard stroke begins");brush.stamp(Vector2i(32,19));brush.end();await settle(projection)
	sessions.discard(scene);await settle(projection)
	check(sessions.entries.values()[0].resource.same_terrain_data(painted),"Discard restores saved rules")
	map.compact_ground_style=0;await settle(projection);map.compact_ground_style=1;await settle(projection)
	check(projection.document.surface_rules==painted.surface_rules,"view switching keeps common source rules")
	scene.queue_free();history.free();await process_frame
	print("SURFACE_RULES ","PASS" if errors.is_empty() else errors);quit(0 if errors.is_empty() else 1)
