extends SceneTree
const Pattern=preload("res://scripts/ember_compact_terrain_pattern.gd")
const Materials=preload("res://scripts/ember_voxel_surface_materials.gd")
func _init() -> void: _run.call_deferred()
func _run() -> void:
	for role in ["grass","soil"]:
		var old=Materials.load_compact_terrain_variant(role+"_relief")
		var new=Materials.load_compact_terrain_variant(role+"_surface")
		assert(old.validation_errors().is_empty() and new.validation_errors().is_empty())
		assert(old.pixels==new.pixels and old.side_pixels==new.side_pixels and old.base_color==new.base_color and old.light_color==new.light_color and old.shadow_color==new.shadow_color)
		assert(old.micro_relief==0.0 and new.micro_relief>0.0)
		for invalid in [{"micro_relief":-0.1},{"micro_relief":INF},{"micro_size_m":0.0},{"micro_size_m":2.0},{"micro_roughness":NAN},{"micro_roughness":1.0}]:
			var broken=new.duplicate(true)
			for key in invalid: broken.set(key,invalid[key])
			assert(not broken.validation_errors().is_empty())
		var mat=Materials.compact_terrain_material()
		Materials.set_compact_terrain_roles(mat,PackedStringArray(["",role]),PackedStringArray(["",role+"_surface"]))
		var lookup: Texture2D=mat.get_shader_parameter("detail_lookup")
		var value=lookup.get_image().get_pixel(1,0)
		assert(is_equal_approx(value.r,new.micro_relief) and is_equal_approx(value.g,new.micro_size_m) and is_equal_approx(value.b,new.micro_roughness))
		var role_lookup: Texture2D=mat.get_shader_parameter("role_lookup")
		assert(roundi(role_lookup.get_image().get_pixel(1,0).b*255)==(1 if role=="grass" else 2))
		Materials.set_compact_terrain_roles(mat,PackedStringArray(["",role]),PackedStringArray(["",role+"_relief"]))
		assert(is_zero_approx((mat.get_shader_parameter("detail_lookup") as Texture2D).get_image().get_pixel(1,0).r))
	var painted=Materials.load_compact_terrain_variant("grass_painted")
	var grass=Materials.load_compact_terrain_variant("grass_surface")
	assert(painted.validation_errors().is_empty() and painted.role_id=="grass")
	assert(painted.base_color==grass.base_color and painted.light_color==grass.light_color and painted.shadow_color==grass.shadow_color)
	assert(painted.pixels!=grass.pixels and painted.side_pixels!=grass.side_pixels)
	assert(painted.micro_size_m>grass.micro_size_m and painted.micro_relief<grass.micro_relief)
	var painted_map=load("res://content/world_terrains/ground_grass_painted_study.res")
	var original_map=load("res://content/world_terrains/ground_material_study.res")
	assert(painted_map.same_terrain_geometry(original_map))
	assert(painted_map.palette_material_ids[1]=="grass_surface" and painted_map.palette_material_ids[2]=="grass_painted")
	assert(painted_map.palette_material_ids[3]==original_map.palette_material_ids[3] and painted_map.palette_material_ids[4]==original_map.palette_material_ids[4])
	var panel=preload("res://addons/ember_import/ember_compact_material_pattern_dialog.gd").new(); root.add_child(panel)
	assert(panel.open_variant("stone_relief","stone"))
	assert(not panel._finish_sliders.micro_relief.editable)
	assert(panel.open_variant("grass_surface","grass"))
	assert(panel._finish_sliders.micro_relief.editable)
	panel.free()
	var scene=(load("res://scenes/ground_material_study.tscn") as PackedScene).instantiate(); root.add_child(scene)
	var map: EmberMapLoader=scene.get_node("Map"); var before=map.compact_terrain.working_copy()
	for frame in 120:
		await process_frame
		if map._visual_surface_projection.pending_tile_count()==0: break
	var projection=map._visual_surface_projection; var tiles=projection.built_tile_count()
	scene.detail_enabled=false; scene.gray_preview=true; await process_frame; await process_frame
	assert(map.compact_terrain.same_terrain_data(before) and projection.built_tile_count()==tiles)
	var mat: ShaderMaterial=projection.get("_ground_material")
	assert(mat.get_shader_parameter("surface_detail_enabled")==false and mat.get_shader_parameter("material_gray_preview")==true)
	var path="user://ember-tests/ground-surface-fixture.tscn"; DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var packed=PackedScene.new(); assert(packed.pack(scene)==OK); assert(ResourceSaver.save(packed,path)==OK)
	var reopened=(ResourceLoader.load(path,"PackedScene",ResourceLoader.CACHE_MODE_IGNORE) as PackedScene).instantiate()
	assert(reopened.detail_enabled==false and reopened.gray_preview==true and reopened.get_node("Map").compact_terrain.same_terrain_data(before))
	reopened.free(); scene.free(); print("GROUND_SURFACE PASS validation/palette/atlas/legacy/no-remesh/scene-save"); quit()
