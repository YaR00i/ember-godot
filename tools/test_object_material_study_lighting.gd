extends SceneTree
func _init() -> void: _run.call_deferred()
func _run() -> void:
	var scene := (load("res://scenes/object_material_study.tscn") as PackedScene).instantiate()
	root.add_child(scene); await process_frame
	var mesh: Mesh = scene.get_node("Sample1/Mesh").mesh
	var vertices: PackedVector3Array = mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX].duplicate()
	var source: Dictionary = scene.sample_sources[1].to_definition()
	var undo := UndoRedo.new()
	scene.sun_yaw = -52; scene.sun_energy = 0.8; scene.apply_settings()
	var before: Dictionary = scene.effective_light()
	undo.create_action("preset"); undo.add_do_property(scene,"light_preset",2); undo.add_undo_property(scene,"light_preset",0); undo.commit_action()
	await process_frame; scene.apply_settings()
	assert(scene.sun_yaw == -52 and scene.sun_energy == 0.8)
	assert(scene.get_node("Sun").rotation_degrees.y == scene.effective_light().yaw)
	undo.undo(); await process_frame; assert(scene.effective_light() == before)
	undo.redo(); await process_frame; assert(scene.light_preset == 2)
	for preset in 3:
		scene.light_preset = preset; scene.apply_settings()
		assert(scene.get_node("Environment").environment.ssao_enabled)
		assert(scene.get_node("Sample1/Mesh").mesh == mesh and mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX] == vertices)
		assert(scene.sample_sources[1].to_definition() == source)
	scene.contact_shading = false; scene.apply_settings(); assert(not scene.get_node("Environment").environment.ssao_enabled)
	scene.gray_preview = true; scene.surface_response = false; scene.apply_settings()
	var mat: ShaderMaterial = scene.get_node("Sample1/Mesh").get_active_material(0)
	assert(mat.get_shader_parameter("surface_gray_preview") and not mat.get_shader_parameter("surface_response_enabled"))
	var packed := PackedScene.new(); assert(packed.pack(scene) == OK)
	assert(ResourceSaver.save(packed,"user://object_material_lighting_test.tscn") == OK)
	var reopened := (ResourceLoader.load("user://object_material_lighting_test.tscn","",ResourceLoader.CACHE_MODE_IGNORE_DEEP) as PackedScene).instantiate()
	assert(reopened.light_preset == 2 and reopened.sun_yaw == -52 and reopened.sun_energy == 0.8 and not reopened.contact_shading)
	assert(reopened.effective_light() == scene.effective_light()); reopened.free()
	undo.clear_history(); undo.free(); scene.free()
	print("test_object_material_study_lighting: PASS preset/one Undo/manual controls/save-reopen/no remesh")
	quit()
